<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <ApplicationId>com.viktormax3.riivolutionisobuilder</ApplicationId>
    <ApplicationTitle>Riivolution ISO Builder</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.16" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiivolutionIsoBuilder.UI\RiivolutionIsoBuilder.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\..\data\banner\**\*" Link="data/banner/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\data\catalog\**\*" Link="data/catalog/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\data\gct\**\*" Link="data/gct/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\data\xml\**\*" Link="data/xml/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\data\tools\titles.txt" Link="data/tools/titles.txt" />
    <AndroidNativeLibrary Include="..\..\data\tools\android-arm64\lib*.so" Link="lib/arm64-v8a/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
