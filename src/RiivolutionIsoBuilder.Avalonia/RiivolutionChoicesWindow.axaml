<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RiivolutionIsoBuilder.Avalonia.RiivolutionChoicesWindow"
        Title="Riivolution Options"
        Width="680"
        Height="520"
        MinWidth="520"
        MinHeight="360">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <ScrollViewer Grid.Row="0">
      <StackPanel x:Name="OptionsPanel" Spacing="12" />
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="Cancel" MinWidth="100" Click="CancelButton_OnClick" />
      <Button Content="OK" MinWidth="100" Click="OkButton_OnClick" />
    </StackPanel>
  </Grid>
</Window>
