<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RiivolutionIsoBuilder.Avalonia.MainWindow"
        Title="Riivolution ISO Builder - Avalonia"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="680"
        Background="#F4F6F8">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#354255" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#687386" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#E7ECF3" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderBrush" Value="#B7C2D0" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#D9E2EE" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderBrush" Value="#99A8BA" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#C8D4E3" />
      <Setter Property="Foreground" Value="#172033" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="#EEF1F5" />
      <Setter Property="Foreground" Value="#8A95A5" />
      <Setter Property="BorderBrush" Value="#D6DDE7" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#E7ECF3" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderBrush" Value="#B7C2D0" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#D9E2EE" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderBrush" Value="#99A8BA" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#166A4D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#166A4D" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#1E7A5A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#1E7A5A" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#8A2E2E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#8A2E2E" />
    </Style>
    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#A33A3A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#A33A3A" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderBrush" Value="#B7C2D0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderBrush" Value="#B7C2D0" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#172033" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
    <Border Grid.Row="0" Background="#223044" Padding="18,16" CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="Riivolution ISO Builder" FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Avalonia desktop preview" Foreground="#BFD0E4" />
          <TextBlock x:Name="StatusText" Text="Starting..." Foreground="#D9E5F2" />
        </StackPanel>
        <Border Grid.Column="1" Background="#31435B" Padding="10,5" CornerRadius="4" VerticalAlignment="Top">
          <TextBlock Text="feature/avalonia-ui" Foreground="#E8F0FA" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="panel">
      <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="6">
        <TextBlock Grid.Column="0" Classes="label" Text="Project root" />
        <TextBlock Grid.Column="1" Classes="label" Text="Games folder" />
        <TextBlock Grid.Column="2" Classes="label" Text="Tools folder" />
        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="ProjectRootText" Classes="muted" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GamesFolderText" Classes="muted" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ToolsFolderText" Classes="muted" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="panel">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ScanButton" Classes="secondary" Content="Scan games" MinWidth="110" Click="ScanButton_OnClick" />
          <Button x:Name="BrowseButton" Classes="secondary" Content="Browse ISO" MinWidth="110" Click="BrowseButton_OnClick" />
          <Button x:Name="XmlButton" Classes="secondary" Content="Browse XML" MinWidth="110" Click="XmlButton_OnClick" />
          <Button x:Name="GctButton" Classes="secondary" Content="Browse GCT" MinWidth="110" Click="GctButton_OnClick" />
          <Button x:Name="ClearLogButton" Classes="secondary" Content="Clear log" MinWidth="96" Click="ClearLogButton_OnClick" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Classes="danger" Content="Cancel" MinWidth="90" Click="CancelButton_OnClick" IsEnabled="False" />
          <Button x:Name="BuildButton" Classes="primary" Content="Build" MinWidth="110" Click="BuildButton_OnClick" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="ActionHintText"
                   Classes="muted"
                   Text="Scan starts automatically. Put backups in games, browse an ISO manually, or load XML/GCT after selecting a game." />
      </Grid>
    </Border>

    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Detected game" />
            <ComboBox x:Name="GamesCombo" SelectionChanged="GamesCombo_OnSelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="SelectedGameText" Classes="muted" Text="No game selected." TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Mod, XML, or GCT" />
            <ComboBox x:Name="ModsCombo" SelectionChanged="ModsCombo_OnSelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="SelectedModText" Classes="muted" Text="No mod selected." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1" Classes="panel">
        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Output ID" />
            <TextBox x:Name="OutputIdBox" MaxLength="6" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="label" Text="Output format" />
            <ComboBox x:Name="ExtensionCombo" />
          </StackPanel>

          <CheckBox Grid.Column="2"
                    x:Name="UseCustomBannerCheck"
                    Content="Use custom banner"
                    IsChecked="True"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8" />

          <ProgressBar Grid.Column="3"
                       x:Name="Progress"
                       IsIndeterminate="True"
                       IsVisible="False"
                       Width="180"
                       Height="18"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,8" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
        <Border Background="#EEF3F8" BorderBrush="#D0DAE6" BorderThickness="1" CornerRadius="4" Padding="12">
          <TextBlock x:Name="EmptyStateText"
                     TextWrapping="Wrap"
                     Foreground="#526174"
                     Text="Waiting for scan results..." />
        </Border>

        <Border Grid.Row="1" Background="#121820" CornerRadius="4" Padding="12">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Log" Foreground="#E2EAF2" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox x:Name="LogBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="#121820"
                     Foreground="#E2EAF2"
                     BorderThickness="0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="4"
               Foreground="#6B7280"
               Text="This is the Avalonia branch UI. The WinForms app remains available on master until feature parity." />
  </Grid>
</Window>
