<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RiivolutionIsoBuilder.Avalonia.MainWindow"
        Title="Riivolution ISO Builder - Avalonia"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Padding="18,16" CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="Riivolution ISO Builder" FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Avalonia desktop preview" Classes="onDarkMuted" />
          <TextBlock x:Name="StatusText" Text="Starting..." Classes="onDark" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" Width="190">
          <Border Background="{DynamicResource HeaderBadgeBrush}" Padding="10,5" CornerRadius="4" HorizontalAlignment="Right">
            <TextBlock Text="feature/avalonia-ui" Classes="onDark" FontWeight="SemiBold" />
          </Border>
          <StackPanel Spacing="4">
            <TextBlock Text="Theme" Classes="onDarkMuted" FontSize="12" />
            <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_OnSelectionChanged" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="panel">
      <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="6">
        <TextBlock Grid.Column="0" Classes="label" Text="Project root" />
        <TextBlock Grid.Column="1" Classes="label" Text="Games folder" />
        <TextBlock Grid.Column="2" Classes="label" Text="Tools folder" />
        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="ProjectRootText" Classes="muted" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GamesFolderText" Classes="muted" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ToolsFolderText" Classes="muted" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="panel">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ScanButton" Classes="secondary" Content="Scan games" MinWidth="110" Click="ScanButton_OnClick" />
          <Button x:Name="BrowseButton" Classes="secondary" Content="Browse ISO" MinWidth="110" Click="BrowseButton_OnClick" />
          <Button x:Name="XmlButton" Classes="secondary" Content="Browse XML" MinWidth="110" Click="XmlButton_OnClick" />
          <Button x:Name="GctButton" Classes="secondary" Content="Browse GCT" MinWidth="110" Click="GctButton_OnClick" />
          <Button x:Name="ClearLogButton" Classes="secondary" Content="Clear log" MinWidth="96" Click="ClearLogButton_OnClick" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Classes="danger" Content="Cancel" MinWidth="90" Click="CancelButton_OnClick" IsEnabled="False" />
          <Button x:Name="BuildButton" Classes="primary" Content="Build" MinWidth="110" Click="BuildButton_OnClick" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="ActionHintText"
                   Classes="muted"
                   Text="Scan starts automatically. Put backups in games, browse an ISO manually, or load XML/GCT after selecting a game." />
      </Grid>
    </Border>

    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Detected game" />
            <ComboBox x:Name="GamesCombo" SelectionChanged="GamesCombo_OnSelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="SelectedGameText" Classes="muted" Text="No game selected." TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Mod, XML, or GCT" />
            <ComboBox x:Name="ModsCombo" SelectionChanged="ModsCombo_OnSelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="SelectedModText" Classes="muted" Text="No mod selected." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1" Classes="panel">
        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Output ID" />
            <TextBox x:Name="OutputIdBox" MaxLength="6" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="label" Text="Output format" />
            <ComboBox x:Name="ExtensionCombo" />
          </StackPanel>

          <CheckBox Grid.Column="2"
                    x:Name="UseCustomBannerCheck"
                    Content="Use custom banner"
                    IsChecked="True"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8" />

          <ProgressBar Grid.Column="3"
                       x:Name="Progress"
                       IsIndeterminate="True"
                       IsVisible="False"
                       Width="180"
                       Height="18"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,8" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Border x:Name="XmlOptionsPanelHost" Classes="panel" IsVisible="False">
          <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock Classes="label" Text="Riivolution XML options" />
            <ScrollViewer Grid.Row="1" MaxHeight="150">
              <StackPanel x:Name="XmlOptionsPanel" Spacing="10" />
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="notice">
          <TextBlock x:Name="EmptyStateText"
                     TextWrapping="Wrap"
                     Classes="muted"
                     Text="Waiting for scan results..." />
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource LogBackgroundBrush}" CornerRadius="4" Padding="12">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Log" Foreground="{DynamicResource LogTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox x:Name="LogBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="{DynamicResource LogBackgroundBrush}"
                     Foreground="{DynamicResource LogTextBrush}"
                     BorderThickness="0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="4"
               Classes="muted"
               Text="This is the Avalonia branch UI. The WinForms app remains available on master until feature parity." />
  </Grid>
</Window>
