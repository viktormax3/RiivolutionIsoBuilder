    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RiivolutionIsoBuilder</AssemblyName>
    <RootNamespace>RiivolutionIsoBuilder</RootNamespace>
